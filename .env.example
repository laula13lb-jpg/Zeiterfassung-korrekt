# Beispielwerte – auf dem Server erzeugt install.sh echte Zufallswerte in .env
DATABASE_URL="postgresql://zeit:zeit@localhost:5432/zeit?schema=public"
# Mindestens 32 zufällige Zeichen: openssl rand -base64 48
APP_SECRET="bitte-ersetzen-durch-langen-zufallswert-mindestens-32-zeichen"
# Öffentliche Adresse der App
APP_URL="http://localhost:3000"
# Bei lokalem Test ohne HTTPS auf "false" setzen
COOKIE_SECURE="false"

# ── nur für docker compose ──
DB_PASSWORD="bitte-ersetzen"
# Einrichtungscode für den ersten Admin (Seite /einrichtung)
SETUP_TOKEN="bitte-ersetzen-mindestens-16-zeichen"
